[
  {
    "output": ["HDMI-A-1", "DP-3"],
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "cava"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["mpris", "cpu", "memory", "custom/gpu", "network", "group/audio", "clock"],

    "modules-left": [
      "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
      "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10",
      "cava"
    ],

    "custom/ws1":  { "exec": "~/.config/waybar/scripts/ws-format.sh 1",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 1})'" },
    "custom/ws2":  { "exec": "~/.config/waybar/scripts/ws-format.sh 2",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 2})'" },
    "custom/ws3":  { "exec": "~/.config/waybar/scripts/ws-format.sh 3",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 3})'" },
    "custom/ws4":  { "exec": "~/.config/waybar/scripts/ws-format.sh 4",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 4})'" },
    "custom/ws5":  { "exec": "~/.config/waybar/scripts/ws-format.sh 5",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 5})'" },
    "custom/ws6":  { "exec": "~/.config/waybar/scripts/ws-format.sh 6",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 6})'" },
    "custom/ws7":  { "exec": "~/.config/waybar/scripts/ws-format.sh 7",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 7})'" },
    "custom/ws8":  { "exec": "~/.config/waybar/scripts/ws-format.sh 8",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 8})'" },
    "custom/ws9":  { "exec": "~/.config/waybar/scripts/ws-format.sh 9",  "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 9})'" },
    "custom/ws10": { "exec": "~/.config/waybar/scripts/ws-format.sh 10", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace = 10})'" },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 40
    },
    "cava": {
      "framerate": 30,
      "autosens": 1,
      "bars": 14,
      "lower_cutoff_freq": 50,
      "higher_cutoff_freq": 10000,
      "method": "pipewire",
      "source": "auto",
      "stereo": true,
      "bar_delimiter": 0,
      "noise_reduction": 0.77,
      "input_delay": 2,
      "hide_on_silence": true,
      "format-icons": ["▁","▂","▃","▄","▅","▆","▇","█"]
    },
    "mpris": {
      "format": " {status_icon} {dynamic}",
      "interval": 1,
      "dynamic-len": 40,
      "status-icons": {
        "playing": "▶",
        "paused": "⏸",
        "stopped": ""
      },
      "dynamic-order": ["title", "artist"],
      "player": "playerctld"
    },
    "cpu": {
      "format": "󰻠 {usage}%",
      "interval": 2
    },
    "memory": {
      "format": "󰍛 {percentage}%",
      "interval": 2
    },
    "custom/gpu": {
      "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
      "interval": 2,
      "format": "󰢮 {}%"
    },
    "network": {
      "interval": 2,
      "format-wifi": "󰖩  󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
      "format-ethernet": "󰇚 {bandwidthDownBytes} 󰕒 {bandwidthUpBytes}",
      "format-disconnected": "󰖪 Disconnected",
      "tooltip-format": "{ifname} via {gwaddr}"
    },
    "group/audio": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 300,
        "children-class": "audio-drawer",
        "transition-left-to-right": false
      },
      "modules": [
        "wireplumber",
        "custom/volume-slider",
        "custom/brightness-slider"
      ]
    },
    "wireplumber": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰝟 Muted",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/volume-slider": {
      "exec": "~/.config/waybar/scripts/volume-slider.sh",
      "interval": 1,
      "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "days": "<span color='#ecc6d9'><b>{}</b></span>",
          "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    }
  }
]
